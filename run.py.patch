+def _feishu_messaging_card_builder_settings(config: dict | None = None) -> dict:
+    """从 config.yaml 读取飞书消息卡片构建器配置。"""
+    cfg = config if config is not None else _load_gateway_config()
+    builder_cfg = cfg.get("feishu_messaging_card_builder", {})
+    return builder_cfg if isinstance(builder_cfg, dict) else {}
+
+
+def _feishu_message_cards_enabled(config: dict | None = None) -> bool:
+    card_cfg = _feishu_messaging_card_builder_settings(config)
+    mode = str(card_cfg.get("mode", "final_only") or "final_only").strip().lower()
+    return bool(card_cfg.get("enabled", False)) and mode in {"final_only", "final"}
+
+
+def _format_feishu_tool_panel(messages: list | None) -> str:
+    if not isinstance(messages, list):
+        return ""
+
+    sections: list[str] = []
+    for msg in messages:
+        if not isinstance(msg, dict) or msg.get("role") != "assistant":
+            continue
+
+        tool_calls = msg.get("tool_calls")
+        if not isinstance(tool_calls, list) or not tool_calls:
+            continue
+
+        for tool_call in tool_calls:
+            if not isinstance(tool_call, dict):
+                continue
+            function = tool_call.get("function") if isinstance(tool_call.get("function"), dict) else {}
+            name = function.get("name") or tool_call.get("name") or "unknown"
+            arguments = function.get("arguments", "")
+            if isinstance(arguments, (dict, list)):
+                try:
+                    arguments = json.dumps(arguments, ensure_ascii=False)
+                except Exception:
+                    arguments = str(arguments)
+            else:
+                arguments = str(arguments or "")
+
+            section = f"- `{name}`"
+            if arguments.strip():
+                section += f"\n```json\n{arguments.strip()}\n```"
+            sections.append(section)
+
+    return "\n\n".join(section for section in sections if section).strip()
+
